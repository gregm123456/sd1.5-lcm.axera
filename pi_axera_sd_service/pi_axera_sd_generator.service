[Unit]
Description=Pi Axera SD Image Generator Service
After=network.target

[Service]
Type=simple
User=gregm
WorkingDirectory=/home/gregm/sd1.5-lcm.axera
ExecStart=/home/gregm/sd1.5-lcm.axera/.venv/bin/python pi_axera_sd_service/pi_axera_sd_generator.py
Restart=on-failure
Environment=VIRTUAL_ENV=/home/gregm/sd1.5-lcm.axera/.venv
Environment=PATH=/home/gregm/sd1.5-lcm.axera/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=TEXT_MODEL_DIR=/home/gregm/sd1.5-lcm.axera/pi_axera_sd_service/models/
Environment=TEXT_ENCODER_MODEL=/home/gregm/sd1.5-lcm.axera/pi_axera_sd_service/models/text_encoder/sd15_text_encoder_sim.axmodel
Environment=UNET_MODEL=/home/gregm/sd1.5-lcm.axera/pi_axera_sd_service/models/unet.axmodel
Environment=VAE_DECODER_MODEL=/home/gregm/sd1.5-lcm.axera/pi_axera_sd_service/models/vae_decoder.axmodel
Environment=VAE_ENCODER_MODEL=/home/gregm/sd1.5-lcm.axera/pi_axera_sd_service/models/vae_encoder.axmodel
Environment=TIME_INPUT_TXT2IMG=/home/gregm/sd1.5-lcm.axera/pi_axera_sd_service/models/time_input_txt2img.npy
Environment=TIME_INPUT_IMG2IMG=/home/gregm/sd1.5-lcm.axera/pi_axera_sd_service/models/time_input_img2img.npy
Environment=OUTPUT_DIR=/home/gregm/sd1.5-lcm.axera/pi_axera_sd_service/output
Environment=HOST=0.0.0.0
Environment=PORT=5000
Environment=PYTHONUNBUFFERED=1
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=CLIP_ASSETS_DIR=/home/gregm/sd1.5-lcm.axera/pi_axera_sd_service/clip_assets

[Install]
WantedBy=multi-user.target